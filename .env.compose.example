# Copy to .env on the future Docker host. Replace every example secret.
# Compose interpolates this file; services do not receive the whole file.
MYSQL_ROOT_PASSWORD=replace-with-unique-root-secret
MATRIX_MYSQL_USER=matrix
MATRIX_MYSQL_PASSWORD=replace-with-unique-operational-secret
MATRIX_API_KEY=replace-with-unique-search-key
MATRIX_ADMIN_API_KEY=replace-with-different-admin-key

# Localhost only until TLS is configured. TLS paths below are container paths.
MATRIX_BIND_HOST=127.0.0.1
MATRIX_PUBLISHED_PORT=50051
MATRIX_TLS_DIR=./docker/tls
MATRIX_GRPC_TLS_CERT=
MATRIX_GRPC_TLS_KEY=
# LAN: set the bind host to the server LAN IP and TLS paths to
# /run/matrix/tls/server.crt and /run/matrix/tls/server.key before starting API.

# Used only by explicit copy/indexing. Replace with the configured source host.
SOURCE_MYSQL_HOST=source-db
SOURCE_MYSQL_PORT=3306
SOURCE_MYSQL_USER=manticore_reader
SOURCE_MYSQL_PASSWORD=replace-with-source-select-only-secret
SOURCE_MYSQL_DATABASE=source_data

MATRIX_SEARCH_PAGE_SIZE=1000
MATRIX_MAX_QUERY_TIME_MS=5000
MATRIX_MAX_CONCURRENT_SEARCHES=16
MANTICORE_ROWS_PER_SHARD=40000000
MANTICORE_SOURCE_CHUNK_ROWS=20000000
MANTICORE_RANGE_STEP=500000
MANTICORE_INDEXER_MEM_LIMIT=2047M
