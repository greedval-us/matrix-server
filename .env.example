# Local Node.js development. Node loads this with --env-file=.env.
MATRIX_AUTH_MODE=shared
MATRIX_API_KEY=replace-with-a-long-random-search-key
MATRIX_ADMIN_API_KEY=replace-with-a-different-admin-key
MATRIX_MODULES=search,catalog
MATRIX_GRPC_HOST=127.0.0.1
MATRIX_GRPC_PORT=50051
MATRIX_GRPC_ENDPOINT=127.0.0.1:50051
MATRIX_GRPC_TLS_CERT=
MATRIX_GRPC_TLS_KEY=
MATRIX_GRPC_TLS_CA=
MANTICORE_URL=http://127.0.0.1:9308
MANTICORE_TABLE=matrix_records
MANTICORE_INDEX_STATE=./state/indexer.json
MATRIX_DATABASE_CATALOG=./state/database-catalog.json
MATRIX_SEARCH_PAGE_SIZE=1000
MATRIX_MAX_QUERY_TIME_MS=5000
MATRIX_MAX_CONCURRENT_SEARCHES=16

# Leave HOST empty for database-free development and snapshot catalogue reads.
# To enable operational MySQL, set HOST and credentials, then run migrations.
MATRIX_MYSQL_HOST=
MATRIX_MYSQL_PORT=3306
MATRIX_MYSQL_USER=matrix
MATRIX_MYSQL_PASSWORD=
MATRIX_MYSQL_DATABASE=matrix
MATRIX_RECORDS_FILE_DIR=./data/files
# MATRIX_MYSQL_PASSWORD_FILE=/absolute/path/to/password

# Source access is only for the explicit copy command; never use it in API env.
# SOURCE_MYSQL_HOST=source-db
# SOURCE_MYSQL_PORT=3306
# SOURCE_MYSQL_USER=manticore_reader
# SOURCE_MYSQL_PASSWORD=replace-with-select-only-secret
# SOURCE_MYSQL_DATABASE=source_data
